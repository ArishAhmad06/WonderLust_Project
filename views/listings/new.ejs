<% layout("/layouts/boilerplate") %>
    <div class="row">
        <h3>Create a New Listing</h3>
        <form method="POST" action="/listings" novalidate class="needs-validation">
            <div class="col-8 offset-2">
                <br><br>
                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input name="listing[title]" type="text" placeholder="enter title" class="form-control" required>
                    <div class="valid-feedback">Title looks good!</div>
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea name="listing[description]" class="form-control" required></textarea>
                    <div class="invalid-feedback">Please enter sort description!</div>
                </div>
                <div class="mb-3">
                    <label for="image" class="form-label">Image Link</label>
                    <input name="listing[image][url]" placeholder="enter image URL/Link" class="form-control">
                </div>
                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="price" class="form-label">Price</label>
                        <input name="listing[price]" placeholder="1300" class="form-control " required>
                        <div class="invalid-feedback">Please enter a valid price.</div>
                    </div>
                    <div class="mb-3  col-md-8">
                        <label for="country" class="form-label">Country</label>
                        <input name="listing[country]" placeholder="India " type="text" class="form-control" required>
                        <div class="invalid-feedback">Please provide a country name.</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
                    <input name="listing[location]" placeholder="Jaipur, Punjab" type="text" class="form-control"
                        required>
                    <div class="invalid-feedback">Please provide a city or area name.</div>
                </div>
                <br><br>
                <button class="btn btn-dark add-btn">Add</button>
        </form>
    </div>
    </div>