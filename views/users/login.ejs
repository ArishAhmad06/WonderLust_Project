<%- layout("/layouts/boilerplate") %>

  <section>
    <div>
      <div class="auth-card auth-card--compact">
        <div class="auth-header">
          <p class="auth-kicker"> Welcome back </p>
          <h1>Log in to StayLuxora</h1>
          <p class="auth-subtitle">Access your trips, listings, and saved destinations.</p>
        </div>
        <form action="/login" method="POST" class="needs-validation auth-form" novalidate>

          <div class="mb-3">
            <label for="username" class="form-label">username</label>
            <input name="username" type="text" class="form-control" required />
            <div class="invalid-feedback">Please enter your username.</div>

          </div>

          <div class="mb-4">
            <label for="password" class="form-label">Password</label>
            <input name="password" id="password" type="password" class="form-control" autocomplete="new-password"
              required />
            <div class="invalid-feedback">Please enter your password.</div>

          </div>

          <button type="submit" class="btn auth-btn">Login</button>
        </form>
        <p class="auth-switch mb-0">
          New to ZyloStays?
          <a href="/signup">Create account</a>
        </p>
      </div>


  </section>